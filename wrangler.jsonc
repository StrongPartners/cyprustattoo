{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyprustattoo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // next/image resizing through Cloudflare Images (AVIF/WebP, like on Vercel).
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "cyprustattoo" }
  ],
  "observability": { "enabled": true }
}
